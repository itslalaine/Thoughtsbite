<style>
  .register-page{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:3rem 1rem;
    background:#FCFCFD;
    position:relative;
    overflow:hidden;
}

/* soft background circles */

.register-page::before,
.register-page::after{
    content:"";
    position:absolute;
    width:350px;
    height:350px;
    border-radius:50%;
    background:#EEF9F7;
    filter:blur(10px);
    z-index:0;
}

.register-page::before{
    top:-120px;
    right:-120px;
}

.register-page::after{
    bottom:-120px;
    left:-120px;
}

.register-card{
    position:relative;
    z-index:2;
    width:min(100%,620px);
    background:#fff;
    border:2px solid #E8E8E8;
    border-radius:28px;
    padding:clamp(2rem,5vw,3rem);
    box-shadow:
    0 15px 45px rgba(0,0,0,.06);
}

.register-logo{
    width:72px;
    height:72px;
    margin:auto;
    border-radius:50%;
    background:#E8F8F6;
    display:flex;
    justify-content:center;
    align-items:center;
    margin-bottom:1.5rem;
}

.register-logo i{
    font-size:2rem;
    color:#41AFA4;
}

.brand{
    text-align:center;
    font-size:clamp(1.8rem,4vw,2.3rem);
    font-weight:700;
    margin-bottom:.2rem;
}

.brand span{
    color:#41AFA4;
}

.register-card h2{
    text-align:center;
    font-size:clamp(1.2rem,1.8vw,1.8rem);
    font-weight:700;
    margin-top:1rem;
}

.subtitle{
    text-align:center;
    color:#6c757d;
    margin-bottom:2rem;
    font-size:1.05rem;
}

.register-card label{
    font-weight:600;
    margin-bottom:.55rem;
}


/* Input container */
.custom-input {
    border: 2px solid #5C5C60;
    border-radius: 10px;
    overflow: hidden;
    transition: border-color .2s, box-shadow .2s;
}

/* Focus state */
.custom-input:focus-within {
    border-color: #41AFA4;
    box-shadow: 0 0 0 3px rgba(65, 175, 164, .12);
}

/* Input icons */
.custom-input .input-group-text {
    background: #fff;
    border: none;
    color: #888;
}

/* Text fields */
.custom-input .form-control {
    border: none;
    outline: none;
    box-shadow: none;
    padding: .4rem;
}

/* Remove Bootstrap's default focus styling */
.custom-input .form-control:focus {
    border: none;
    outline: none;
    box-shadow: none;
}

/* Validation error state */
.custom-input.has-error,
.custom-input.has-error:focus-within {
    border-color: #dc3545;
    box-shadow: none;
}

/* Validation message */
.field-error {
    color: #dc3545;
    font-size: .875rem;
    margin-top: .35rem;
}

.register-btn{
    background:#41AFA4;
    color:#fff;
    padding:.4rem;
    border-radius:10px;
    font-weight:600;
    transition:.25s;
}

.register-btn:hover{
    color:#fff;
    background:#37998f;
}

.login-link{
    margin-top:2rem;
    text-align:center;
    color:#6c757d;
}

.login-link a{
    color:#41AFA4;
    font-weight:600;
    text-decoration:none;
}

.login-link a:hover{
    text-decoration:underline;
}
</style>
<div class="register-page">

    <div class="register-card">

        <!-- Logo -->
        <!-- <div class="register-logo">
            <i class="bi bi-journal-bookmark"></i>
        </div> -->

        <h1 class="brand">ThoughtsBite</h1>

        <h2>Create your account</h2>

        <p class="subtitle">
            Start capturing your thoughts, reflections,
            and learnings.
        </p>

        <form action="/auth/register" method="POST">

            <div class="row g-3">


                <div class="col-md-6">
                     <label>First Name</label>
                    <div class="input-group custom-input <%= errors?.firstName ? 'has-error' : '' %>">

                        <span class="input-group-text">
                            <i class="bi bi-person"></i>
                        </span>

                        <input
                            type="text"
                            name="firstName"
                            class="form-control"
                            value="<%= oldInput?.firstName || '' %>"
                            placeholder="Juan"
                        >
                    </div>

                    <% if (errors?.firstName) { %>
                        <div class="field-error">
                            <%= errors.firstName %>
                        </div>
                    <% } %>
                </div>

                <div class="col-md-6">
                    <label>Last Name</label>
                    <div class="input-group custom-input <%= errors?.lastName ? 'has-error' : '' %>">

                        <span class="input-group-text">
                            <i class="bi bi-person"></i>
                        </span>

                        <input
                            type="text"
                            name="lastName"
                            class="form-control"
                            value="<%= oldInput?.lastName || '' %>"
                            placeholder="Doe"
                        >
                    </div>

                    <% if (errors?.lastName) { %>
                        <div class="field-error">
                            <%= errors.lastName %>
                        </div>
                    <% } %>
                </div>

            </div>

            <div class="mt-3">

                <label>Email</label>

                    <div class="input-group custom-input <%= errors?.email ? 'has-error' : '' %>">

                        <span class="input-group-text">
                            <i class="bi bi-envelope"></i>
                        </span>

                        <input
                            type="email"
                            name="email"
                            class="form-control"
                            value="<%= oldInput?.email || '' %>"
                            placeholder="juandoe@email.com"
                        >
                    </div>

                    <% if (errors?.email) { %>
                        <div class="field-error">
                            <%= errors.email %>
                        </div>
                    <% } %>

            </div>

            <div class="mt-3">

                <label>Password</label>

                    <div class="input-group custom-input <%= errors?.password ? 'has-error' : '' %>">

                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>

                        <input
                            type="password"
                            name="password"
                            class="form-control"
                            value="<%= oldInput?.password || '' %>"
                            placeholder="Create a password"
                        >
                    </div>

                    <% if (errors?.password) { %>
                        <div class="field-error">
                            <%= errors.password %>
                        </div>
                    <% } %>

            </div>

            <button class="btn register-btn w-100 mt-4">
                Create Account
            </button>

        </form>

        <div class="login-link">

            Already have an account?

            <a href="/auth/login">
                Sign in
            </a>

        </div>

    </div>

</div>