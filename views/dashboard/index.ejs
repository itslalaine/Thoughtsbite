<style>

.home-wrapper{
    width:min(92%,1200px);
    margin:clamp(2rem,5vw,4rem) auto 5rem;
}


.hero{
    text-align:center;
    margin-bottom:4rem;
}

.hero-title{

    font-size:clamp(2.5rem,7vw,5.5rem);
    font-weight:700;
    line-height:1.05;
    margin-bottom:1rem;

}

.hero-subtitle{
    max-width:560px;
    margin:0 auto 2rem;
    color:#5C5C60;
    font-size:clamp(1rem,2vw,1.35rem);
    line-height:1.7;
}

.btn-capture{
    display:inline-flex;
    align-items:center;
    gap:.65rem;
    padding:.9rem 1.8rem;
    background:#2CB6A3;
    color:white;
    border-radius:999px;
    font-weight:600;
    text-decoration:none;
    transition:.25s;
}

.btn-capture:hover{
    background:#23A090;
    color:white;
}

.quick-stats{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:1rem;
    margin-top:3rem;
}

.stat-pill{
    display:flex;
    align-items:center;
    gap:.55rem;
    padding:.6rem 1.3rem;
    background:#fff;
    border:3px solid #5c5c60;
    border-radius:999px;
    font-size:.92rem;
    font-weight:600;
}


.home-section{

    margin-top:5rem;
    text-align:center;

}

.home-section h2{
    font-size:clamp(2rem,4vw,2.8rem);
    font-weight:700;
}

.home-section p{
    color:#5C5C60;
    margin-bottom:3rem;
    font-size:clamp(1rem,1.5vw,1.15rem);
}

.home-section .thought-snippet{
    text-align: left;
    font-size:clamp(0.9rem,1vw,1.15rem);
}

/* Reuse existing thought-item styling */

.home-thoughts{

    max-width:760px;
    margin:auto;

}

.btn-view-all{

    display:inline-flex;

    margin-top:2.5rem;

    padding:.7rem 2.5rem;

    background:#35354B;

    color:white;

    border-radius:999px;

    text-decoration:none;

    font-weight:600;

    transition:.25s;

}

.btn-view-all:hover{

    background:#2B2B3E;
    color:white;

}


.empty-state{
    padding:5rem 1rem;
    color:#777;
}

.empty-state i{

    font-size:3rem;
    margin-bottom:1rem;
    display:block;

}

.icon{
    background: #5c5c60;;
}

.icons{
    color:#5c5c60;
}

.theme-mindset{
    background:#B69AE8;
}

.theme-growth{
    background:#8BCF9B;
}

.theme-productivity{
    background:#6FC3D6;
}

.theme-discipline{
    background:#F6B26B;
}

.theme-life{
    background:#F5D76E;
}

.theme-other{
    background:#C8C8C8;
}



</style>
<div class="home-wrapper">

    <!-- HERO -->

    <section class="hero">

        <h1 class="hero-title">
            <%= greeting %>, <%= user.firstName %>!
        </h1>

        <p class="hero-subtitle">
            Every reflection, no matter how small,
            brings you closer to growth.
        </p>

        <a href="/thoughts/add" class="btn-capture">

            <i class="bi bi-plus-lg"></i>

            Capture Today's Thought

        </a>

        <div class="quick-stats">

            <div class="stat-pill">
                <i class="bi bi-fire icons"></i>
                <span><%= streak %> day streak</span>

            </div>

            <div class="stat-pill">
                <i class="bi bi-journal-album icons"></i>
                <span><%= thoughtsThisWeek %> thoughts this week</span>
            </div>

            <div class="stat-pill">
                <i class="bi bi-journals icons"></i>
                <span><%= totalThoughts %> total thoughts</span>
            </div>

            <div class="stat-pill">
                <span class="theme-dot icon"></span>
                <span><%= mostUsedTheme %></span>
            </div>

        </div>

    </section>

    <!-- RECENT -->

    <section class="home-section">

        <h2>Recent Thoughts</h2>

        <p>A quick look at your latest insights</p>

        <% if(recentThoughts.length === 0){ %>

            <div class="empty-state">

                <i class="bi bi-journal-x"></i>

                <h5>No thoughts yet</h5>

                <p>
                    Capture your first reflection to begin your journey.
                </p>

            </div>

        <% }else{ %>

            <div class="home-thoughts">

                <% recentThoughts.forEach(thought=>{ %>

                    <div class="thought-item rounded-4 p-3 mb-3 shadow-sm" data-href="/thoughts/<%= thought._id %>">
                        <!-- Header -->
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div>
                                <h6 class="theme-badge mb-2">
                                    <span class="theme-dot theme-<%= thought.theme.toLowerCase() %>"></span>
                                    <%= thought.theme %>
                                </h6>
                            </div>
                            <!-- Three dots menu -->
                            <div class="dropdown">
                                <small class="text-muted thought-date me-2">
                                <%= thought.displayDate %>
                                </small>
                                <button
                                class="btn btn-icon dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                >
                                <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li>
                                    <a class="dropdown-item" href="/thoughts/edit/<%= thought._id %>">
                                    <i class="bi bi-pencil me-2"></i>Edit
                                    </a>
                                </li>
                                <li>
                                <form
                                    action="/thoughts/<%= thought._id %>/delete"
                                    method="POST"
                                    class="deleteThoughtForm">
                                    <button class="dropdown-item text-danger">
                                        <i class="bi bi-trash me-2"></i>Remove
                                    </button>
                                    </form>
                                </li>
                                </ul>
                            </div>
                            </div>

                            <!-- Snippet -->
                            <p class="thought-snippet mt-3 mb-4"><%= (thought.content || "").trim() %></p>
                            <!-- Tags -->

                            <hr class="thought-divider">

                            <div class="thought-footer">

                            <% if (thought.mood) { %>

                                <div class="thought-meta">

                                    <% if (thought.mood === "motivated") { %>
                                        <i class="bi bi-emoji-heart-eyes emoji"></i>
                                    <% } %>

                                    <% if (thought.mood === "neutral") { %>
                                        <i class="bi bi-emoji-expressionless emoji"></i>
                                    <% } %>

                                    <% if (thought.mood === "confused") { %>
                                        <i class="bi bi-emoji-tear emoji"></i>
                                    <% } %>

                                    <% if (thought.mood === "inspired") { %>
                                        <i class="bi bi-emoji-laughing emoji"></i>
                                    <% } %>

                                    <% if (thought.mood === "overwhelmed") { %>
                                        <i class="bi bi-emoji-dizzy emoji"></i>
                                    <% } %>

                                    <span><%= thought.mood.charAt(0).toUpperCase() + thought.mood.slice(1) %></span>

                                </div>

                            <% } %>

                            <% if (thought.sourceType) { %>

                            <div class="thought-meta">

                                <% if (thought.sourceType === "Book") { %>
                                    <i class="bi bi-book-half"></i>

                                <% } else if (thought.sourceType === "Video") { %>
                                    <i class="bi bi-play-circle-fill"></i>

                                <% } else if (thought.sourceType === "Podcast") { %>
                                    <i class="bi bi-mic-fill"></i>

                                <% } else if (thought.sourceType === "Article") { %>
                                    <i class="bi bi-newspaper"></i>

                                <% } else if (thought.sourceType === "Course") { %>
                                    <i class="bi bi-mortarboard-fill"></i>

                                <% } else if (thought.sourceType === "Movie") { %>
                                    <i class="bi bi-camera-reels-fill"></i>

                                <% } else if (thought.sourceType === "Conversation") { %>
                                    <i class="bi bi-chat-dots-fill"></i>

                                <% } else if (thought.sourceType === "Social Media") { %>
                                    <i class="bi bi-instagram"></i>

                                <% } else { %>
                                    <i class="bi bi-archive-fill"></i>
                                <% } %>

                                <span>
                                    <% if (thought.sourceType === "Article") { %>
                                        Article / Blog
                                    <% } else if (thought.sourceType === "Movie") { %>
                                        Movie / Documentary
                                    <% } else { %>
                                        <%= thought.sourceType %>
                                    <% } %>
                                </span>

                            </div>

                            <% } %>

                            </div>
                        </div>

                                <% }) %>

            </div>

            <a href="/thoughts" class="btn-view-all">

                View All Thoughts

            </a>

        <% } %>

    </section>

</div>


